    "gyre_heat_efficiency": { "value": 0.3, "unit": "", "kind": "tunable", "source": "Fraction of the barotropic gyre transport that carries mixed-layer temperature contrasts; calibrated to ~1 PW wind-driven ocean heat transport (Trenberth & Caron 2001)" },
